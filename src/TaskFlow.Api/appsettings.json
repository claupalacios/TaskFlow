{
  "ConnectionStrings": {
    "TaskFlow": "Data Source=taskflow.db"
  },
  "Jwt": {
    "Issuer": "TaskFlow",
    "Audience": "TaskFlow.Client",
    "ExpirationMinutes": 60
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
